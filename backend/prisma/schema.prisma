generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Inverters {
  id              String           @id
  block           String
  status          String
  last_updated    DateTime         @default(now())
  Alerts          Alerts[]
  ForecastPoints  ForecastPoint[]
  ForecastUploads ForecastUpload[]
  Maintenance     Maintenance[]
  Predictions     Predictions[]
  Telemetry       Telemetry[]
}

model Telemetry {
  id                String    @id @default(uuid())
  inverter_id       String
  timestamp         DateTime  @default(now())
  ac_current_a      Float
  ac_voltage_v      Float
  alarm_code        Int
  ambient_temp_c    Float
  daily_kwh         Float
  dc_current_a      Float
  dc_voltage_v      Float
  device_timestamp  DateTime?
  frequency_hz      Float
  inverter_temp_c   Float
  op_state          Int
  power_kw          Float
  price_per_kwh_inr Float
  pv1_power_kw      Float
  Inverter          Inverters @relation(fields: [inverter_id], references: [id])
}

model Predictions {
  id              String    @id @default(uuid())
  inverter_id     String
  risk_score      Float
  risk_level      String
  explanation     String
  created_at      DateTime  @default(now())
  current_score   Float?
  current_status  String?
  daily_table     Json?
  eta_display     String?
  eta_hours       Float?
  model_output    Json?
  per_model_probs Json?
  primary_cause   String?
  total_loss_inr  Float?
  total_loss_kwh  Float?
  Inverter        Inverters @relation(fields: [inverter_id], references: [id])
}

model Alerts {
  id              String    @id @default(uuid())
  inverter_id     String
  severity        String
  message         String
  created_at      DateTime  @default(now())
  acknowledged_at DateTime?
  dismissed_at    DateTime?
  status          String    @default("Active")
  updated_at      DateTime  @default(now()) @updatedAt
  Inverter        Inverters @relation(fields: [inverter_id], references: [id])
}

model Users {
  id               String           @id @default(uuid())
  name             String
  email            String           @unique
  password         String
  role             String           @default("operator")
  ChatSession      ChatSession[]
  forecast_uploads ForecastUpload[]
}

model Maintenance {
  id               String    @id @default(uuid())
  inverter_id      String
  issue            String
  status           String
  scheduled_date   DateTime?
  created_at       DateTime  @default(now())
  details          String?
  resolution_notes String?
  resolved_at      DateTime?
  updated_at       DateTime  @default(now()) @updatedAt
  Inverter         Inverters @relation(fields: [inverter_id], references: [id])
}

model Reports {
  id           String   @id @default(uuid())
  title        String
  type         String
  date         DateTime @default(now())
  size         String
  generated_by String?
}

model ForecastUpload {
  id             String          @id @default(uuid())
  user_id        String
  inverter_id    String?
  csv_content    String
  rows_count     Int             @default(0)
  source         String          @default("csv")
  created_at     DateTime        @default(now())
  ForecastPoints ForecastPoint[]
  Inverter       Inverters?      @relation(fields: [inverter_id], references: [id])
  User           Users           @relation(fields: [user_id], references: [id])
}

model ForecastPoint {
  id                 String          @id @default(uuid())
  upload_id          String?
  inverter_id        String
  minute_offset      Int
  timestamp_iso      String
  predicted_power_kw Float
  risk_score         Float
  source             String          @default("pretrained")
  created_at         DateTime        @default(now())
  Inverter           Inverters       @relation(fields: [inverter_id], references: [id])
  Upload             ForecastUpload? @relation(fields: [upload_id], references: [id])

  @@index([inverter_id, minute_offset])
  @@index([inverter_id, created_at])
}

model ChatMessage {
  id          String      @id
  sessionId   String
  role        String
  content     String
  createdAt   DateTime    @default(now())
  ChatSession ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model ChatSession {
  id          String        @id
  userId      String
  title       String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime
  ChatMessage ChatMessage[]
  Users       Users         @relation(fields: [userId], references: [id])
}
